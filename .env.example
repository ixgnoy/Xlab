# Copy to .env (non-secret settings). Secrets go in .env.local (git-ignored, chmod 600).
# Load order for every npm script: real process env > .env.local > .env  (Node --env-file, later file wins; existing env vars are never overwritten).
# Model: any OpenAI-compatible endpoint.
#   OpenRouter:  MODEL_BASE_URL=https://openrouter.ai/api/v1   MODEL_ID=deepseek/deepseek-v4.1-flash
#   DeepSeek:    MODEL_BASE_URL=https://api.deepseek.com/v1    MODEL_ID=deepseek-flash
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_ID=
# Optional fallback when the primary endpoint fails (secret, .env.local only): OPENROUTER_API_KEY=  FALLBACK_MODEL_ID=deepseek/deepseek-v4.1-flash
# Secret - put in .env.local only:
MODEL_API_KEY=

CREST_GRAPH_PORT=21951
CREST_GRAPH_URL=http://127.0.0.1:21951
# Create-stage images via OpenRouter (needs OPENROUTER_API_KEY). Saved to .local/media/<run_id>/, served on loopback.
IMAGE_GENERATION=on
IMAGE_MODEL_ID=google/gemini-3.1-flash-lite-image
MAX_IMAGES=4
MAX_USD_PER_TASK=3
COWORKER_ID=
# Workspaces the worker polls, comma-separated: "personal" and/or "org:ORG_ID:WORKSPACE_SLUG".
# tasks list uses --organization-slug SLUG; runtime start/complete use --organization-id ORG_ID (never with --personal).
# Paid Tasks run only for the personal target. Unset = the default below.
WORKER_TARGETS=personal,org:01a109d1-32a9-71a3-a0e3-658b2a7987cd:token2049-origins-hackathon-2026-nws2r7

# Payment (step 4). Secret Blockfrost key goes in .env.local.
BLOCKFROST_API_KEY_PREPROD=
MPS_PORT=38127
MPS_URL=http://127.0.0.1:38127
AGENT_API_PORT=21950
PAID_TASKS_ENABLED=false

# Written automatically (secret, .env.local only): Coworker runtime key and local graph token
# SOKOSUMI_COWORKER_API_KEY=
# CREST_GRAPH_TOKEN=
